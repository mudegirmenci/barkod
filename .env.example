# PostgreSQL Veritabanı Bağlantısı (Supabase, Neon, Railway veya Yerel PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/barkod_db?schema=public"

# NextAuth Yapılandırması
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-generated-nextauth-secret-here"

# Google OAuth Kimlik Bilgileri
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
